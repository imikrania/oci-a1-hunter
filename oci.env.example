# Copy to oci.env, fill in, then run:  bash set-secrets.sh
# (oci.env and *.pem are gitignored - never commit them)

OCI_USER_OCID=ocid1.user.oc1..aaaaaaaa
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaaa
OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99
OCI_REGION=ap-tokyo-1
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..aaaaaaaa
OCI_IMAGE_ID=ocid1.image.oc1..aaaaaaaa
OCI_SUBNET_ID=ocid1.subnet.oc1..aaaaaaaa
OCI_SSH_PUBLIC_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... you@host
OCI_OCPUS=1
OCI_MEMORY_GB=6
OCI_DISPLAY_NAME=a1-hunter
